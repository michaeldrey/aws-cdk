{
 "Resources": {
  "GrafanaRole3A2DB257": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": "sts:AssumeRole",
       "Effect": "Allow",
       "Principal": {
        "Service": "grafana.amazonaws.com"
       }
      }
     ],
     "Version": "2012-10-17"
    }
   }
  },
  "SamlWorkspace41F79B5F": {
   "Type": "AWS::Grafana::Workspace",
   "Properties": {
    "AccountAccessType": "CURRENT_ACCOUNT",
    "AuthenticationProviders": [
     "SAML"
    ],
    "Description": "SAML-authenticated Grafana Workspace",
    "GrafanaVersion": "10.4",
    "Name": "saml-workspace",
    "PermissionType": "CUSTOMER_MANAGED",
    "RoleArn": {
     "Fn::GetAtt": [
      "GrafanaRole3A2DB257",
      "Arn"
     ]
    },
    "SamlConfiguration": {
     "AllowedOrganizations": [
      "myorg"
     ],
     "AssertionAttributes": {
      "Email": "email",
      "Groups": "group",
      "Login": "login",
      "Name": "displayName",
      "Org": "org",
      "Role": "role"
     },
     "IdpMetadata": {
      "Xml": "<md:EntityDescriptor xmlns:md='urn:oasis:names:tc:SAML:2.0:metadata' entityID='entityId'>DATA</md:EntityDescriptor>"
     },
     "LoginValidityDuration": 60,
     "RoleValues": {
      "Admin": [
       "admin-group"
      ],
      "Editor": [
       "editor-group"
      ]
     }
    }
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}